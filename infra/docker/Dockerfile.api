# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm

WORKDIR /app

RUN useradd --create-home --uid 10001 formal \
  && mkdir -p /app/.data \
  && chown -R formal:formal /app

COPY packages /app/packages
COPY services/certificate-service /app/services/certificate-service
COPY services/proof-service /app/services/proof-service
COPY services/retrieval-service /app/services/retrieval-service
COPY apps/api /app/apps/api
COPY lean /app/lean
COPY pyproject.toml /app/pyproject.toml
COPY README.md /app/README.md
COPY infra/docker/entrypoint-api.sh /app/entrypoint-api.sh

RUN pip install --no-cache-dir \
  /app/packages/shared \
  /app/packages/schemas \
  /app/packages/domain \
  /app/packages/provenance \
  "/app/packages/certificate-sdk[crypto]" \
  /app/packages/store \
  /app/services/proof-service \
  /app/services/certificate-service \
  /app/services/retrieval-service \
  /app/apps/api \
  "fastapi>=0.115" \
  "uvicorn[standard]>=0.32" \
  "pydantic-settings>=2.6" \
  "httpx>=0.28" \
  "sqlalchemy[asyncio]>=2.0" \
  "alembic>=1.14" \
  "psycopg[binary]>=3.2" \
  "python-multipart>=0.0.9" \
  "cryptography>=43" \
  "boto3>=1.35" \
  && chmod +x /app/entrypoint-api.sh \
  && chown -R formal:formal /app

USER formal
WORKDIR /app/apps/api
ENV API_HOST=0.0.0.0
ENV API_PORT=8000
ENV AUTO_CREATE_TABLES=false
EXPOSE 8000
CMD ["python", "-m", "formal_api.main"]
