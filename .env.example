# Formal Platform — environment template
# Copy to `.env` and replace every <SET_ME> value. Never commit a real `.env`.
# Production checklist: docs/operations/production.md

PLATFORM_ENV=development
LOG_LEVEL=INFO

# PostgreSQL — replace <SET_ME> before first run
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=formal_platform
POSTGRES_USER=formal
POSTGRES_PASSWORD=<SET_ME>
DATABASE_URL=postgresql+psycopg://formal:<SET_ME>@localhost:5432/formal_platform

# Object storage (MinIO / S3-compatible) — replace <SET_ME>
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=<SET_ME>
S3_SECRET_KEY=<SET_ME>
S3_BUCKET=formal-artifacts
S3_REGION=us-east-1
BLOB_ROOT=.data/blobs

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Comma-separated Bearer tokens; required when PLATFORM_ENV=production
API_KEYS=
AUTO_CREATE_TABLES=true
OPENAPI_ENABLED=true
ALLOW_UNVERIFIED_ISSUANCE=true
REQUIRE_LEAN_FOR_ISSUANCE=false
DEFAULT_PRINCIPAL_ID=dev-user
PROOF_ALLOWED_ROOTS=

# Proof service
PROOF_SERVICE_URL=http://localhost:8001
PROOF_SERVICE_TOKEN=
PROOF_WORKER_TIMEOUT_SECONDS=300
CERTIFICATE_REMOTE_PROOF=0
LEAN_PROJECT_DIR=
LEAN_CHECK_PROJECT_PATH=

# Certificate service
CERTIFICATE_SERVICE_URL=http://localhost:8002
CERTIFICATE_SIGNING_KEY_ID=dev-key-1
# Use a long random string in real deployments (>= 32 chars)
CERTIFICATE_SIGNING_SECRET=<SET_ME>
CERTIFICATE_ED25519_PRIVATE_KEY_HEX=
CERTIFICATE_ED25519_PUBLIC_KEY_HEX=

# Retrieval
RETRIEVAL_SERVICE_URL=http://localhost:8003

# Web (apps/web also has its own .env.example)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_KEY=
NEXT_PUBLIC_PRINCIPAL_ID=dev-user
NEXT_PUBLIC_REQUIRE_LEAN=false
