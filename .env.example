# Formal Platform — local development defaults
# Copy to .env and adjust. Never commit real secrets.
# Production: see docs/operations/production.md and docker-compose.prod.yml

PLATFORM_ENV=development
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=formal_platform
POSTGRES_USER=formal
POSTGRES_PASSWORD=formal_dev_change_me
DATABASE_URL=postgresql+psycopg://formal:formal_dev_change_me@localhost:5432/formal_platform

# Object storage (MinIO / S3-compatible)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=formal-artifacts
S3_REGION=us-east-1
BLOB_ROOT=.data/blobs

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
API_KEYS=
AUTO_CREATE_TABLES=true
OPENAPI_ENABLED=true
ALLOW_UNVERIFIED_ISSUANCE=true
REQUIRE_LEAN_FOR_ISSUANCE=false
DEFAULT_PRINCIPAL_ID=dev-user
PROOF_ALLOWED_ROOTS=

# Proof service
PROOF_SERVICE_URL=http://localhost:8001
PROOF_SERVICE_TOKEN=
PROOF_WORKER_TIMEOUT_SECONDS=300
CERTIFICATE_REMOTE_PROOF=0
LEAN_PROJECT_DIR=
LEAN_CHECK_PROJECT_PATH=

# Certificate service
CERTIFICATE_SERVICE_URL=http://localhost:8002
CERTIFICATE_SIGNING_KEY_ID=dev-key-1
CERTIFICATE_SIGNING_SECRET=dev_signing_secret_change_me_before_prod
CERTIFICATE_ED25519_PRIVATE_KEY_HEX=
CERTIFICATE_ED25519_PUBLIC_KEY_HEX=

# Retrieval
RETRIEVAL_SERVICE_URL=http://localhost:8003

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=
NEXT_PUBLIC_PRINCIPAL_ID=dev-user
NEXT_PUBLIC_REQUIRE_LEAN=false
