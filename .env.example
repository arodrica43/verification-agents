# Formal Platform — local development defaults
# Copy to .env and adjust. Never commit real secrets.

PLATFORM_ENV=development
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=formal_platform
POSTGRES_USER=formal
POSTGRES_PASSWORD=formal_dev_change_me
DATABASE_URL=postgresql+psycopg://formal:formal_dev_change_me@localhost:5432/formal_platform

# Object storage (MinIO / S3-compatible)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=formal-artifacts
S3_REGION=us-east-1

# Redis (optional Phase 0+)
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# Proof service
PROOF_SERVICE_URL=http://localhost:8001
PROOF_WORKER_TIMEOUT_SECONDS=300
PROOF_WORKER_MEMORY_MB=2048

# Certificate signing (dev only — replace in production)
CERTIFICATE_SIGNING_KEY_ID=dev-key-1
CERTIFICATE_SIGNING_SECRET=dev_signing_secret_change_me_before_prod

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
