# Formal Platform API — browser-side config
# Prefer 127.0.0.1 over localhost (Windows IPv6). Next.js also proxies /platform-api.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_PRINCIPAL_ID=dev-user
# Set when the API has API_KEYS configured:
# NEXT_PUBLIC_API_KEY=<SET_ME>
NEXT_PUBLIC_REQUIRE_LEAN=false
